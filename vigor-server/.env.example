# Database Configuration
DATABASE_URL=postgresql://vigor:vigor_password@localhost:5432/vigor_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# External API Keys
DOUYIN_API_KEY=your_douyin_api_key_here
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_ENDPOINT_ID=ep-xxxxxxxxxxxx-xxxxx

# Security
SECRET_KEY=your_secret_key_here_change_in_production
API_KEY=your_api_key_here_change_in_production

# Doubao
DOUBAO_MOCK_MODE=true
AUTO_GENERATE_SUMMARY_AFTER_CRAWL=false

# Douyin
DOUYIN_MOCK_MODE=true
DOUYIN_API_BASE_URL=https://api.douyin.example.com
DOUYIN_MAX_CONCURRENCY=5
DOUYIN_LOGIN_TYPE=qrcode
DOUYIN_COOKIES=
DOUYIN_ENABLE_CDP_MODE=false
DOUYIN_HEADLESS=true

# Bilibili
BILIBILI_MOCK_MODE=true
BILIBILI_MAX_CONCURRENCY=3

# Environment
ENVIRONMENT=development
